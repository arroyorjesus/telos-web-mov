# ─── TELOS WEB MOV — Environment Variables ───────────────────────────────────
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://telos.com.mx
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Email (choose one provider) ─────────────────────────────────────────────
EMAIL_PROVIDER=resend
# Options: resend | sendgrid | nodemailer

# Resend (recommended — free up to 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# OR SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# OR Nodemailer (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-app-password

# Email addresses
EMAIL_TO=ahorro@telos.com.mx
EMAIL_FROM=TELOS <noreply@telos.com.mx>

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Optional — leads/cotizaciones use a local JSON mock in development if not set
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cotizador / CRM ─────────────────────────────────────────────────────────
# Contraseña única de acceso a /cotizador y /cotizaciones (middleware).
COTIZADOR_PASSWORD=cambia-esta-contraseña

# ─── Analytics ───────────────────────────────────────────────────────────────
# Add GA4 / GTM IDs when ready
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
